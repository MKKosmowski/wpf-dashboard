<Window x:Class="ModernUITutorial.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModernUITutorial.Views"
        xmlns:viewModel="clr-namespace:ModernUITutorial.ViewModel"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="MainView" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.DataContext>
        <viewModel:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
            <local:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:CustomerViewModel}">
            <local:CustomerView />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="10"
			BorderThickness="1">
        
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0" />
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75" />
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>

            <Grid.ColumnDefinitions>
                <!-- Navigation menu -->
                <ColumnDefinition Width="250" />
                <!-- Content section -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Navigation Menu -->
            <Border CornerRadius="10,0,0,10"
                    Grid.Column="0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0" />
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal"
                                Height="35"
                                Margin="15,25,0,40">

                        <Image Source="/Images/logo.png" />
                        <TextBlock Text="UI PROJECT" 
                                   Foreground="{StaticResource titleColor2}"
                                   FontSize="20"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontFamily="/Fonts/#Montserrat" />

                    </StackPanel>
                    
                    <!-- Menu buttons -->
                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Command="{Binding ShowHomeViewCommand}"
                                 IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Home" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Dashboard" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color2}"
                           Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Group" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Customers" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color3}"
                                                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Truck" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Order" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color4}"
                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ShoppingBag" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Transaction" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color5}"
                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Dropbox" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Stock" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color6}"
                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Money" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Financial" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>


                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color7}"
                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="PieChart" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Report" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>


                    <RadioButton Style="{StaticResource menuButton}"
                          Tag="{StaticResource color8}"
                            Command="{Binding ShowCustomerViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Wrench" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Tools" Style="{StaticResource menuButtonText}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                
            </Border>
            
            <!-- Main Section -->
            <Border CornerRadius="0,10,10,0"
                    Grid.Column="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0" />
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>


                <Grid>

                    <Grid.RowDefinitions>
                        <!--Control Bar--> 
                        <RowDefinition Height="25" />
                        <!--Header / Caption-->
                        <RowDefinition Height="35" />
                        <!--Content section / Child view--> 
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                
                    <!--Control bar-->
                    <StackPanel x:Name="pnlControlBar"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                Background="Transparent"
                                Margin="0,0,5,0"
                                MouseDown="pnlControlBar_MouseDown"
                                MouseEnter="pnlControlBar_MouseEnter">

                        <Button x:Name="btnClose"
                                Style="{StaticResource controlBarButton}"
                                Tag="{StaticResource color4}"
                                Click="btnClose_Click">
                            <fa:ImageAwesome Icon="Close" Width="12" Style="{StaticResource controlBarButtonIcon}" />
                        </Button>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource controlBarButton}"
                                Tag="{StaticResource color8}"
                                Click="btnMaximize_Click">
                            <fa:ImageAwesome Icon="WindowMaximize" Width="12" Style="{StaticResource controlBarButtonIcon}" />
                        </Button>

                        <Button x:Name="btnMinimize"
                                  Style="{StaticResource controlBarButton}"
                                  Tag="{StaticResource color6}"
                                  Click="btnMinimize_Click">
                            <fa:ImageAwesome Icon="WindowMinimize" Width="12" Style="{StaticResource controlBarButtonIcon}" />
                        </Button>

                    </StackPanel>
                    
                    <!--Header / Caption-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        
                        <!--Caption-->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <fa:ImageAwesome Icon="{Binding Icon}"
                                             Height="20"
                                             Width="20"
                                             Foreground="{StaticResource titleColor2}"
                                             Margin="35,0,10,0" />

                            <TextBlock Text="{Binding Caption}"
                                       Foreground="{StaticResource titleColor2}"
                                       FontSize="16"
                                       FontFamily="/Fonts/#Montserrat"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                        
                        <!--User options-->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">

                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color1}">
                                <fa:ImageAwesome Icon="AngleDown"
                                                 Height="12" Width="12"
                                                 Style="{StaticResource iconButtonIcon}" />
                            </Button>

                            <TextBlock Text="{Binding CurrentUserAccount.DisplayName}"
                                       Foreground="{StaticResource titleColor3}"
                                       FontFamily="/Fonts/#Montserrat"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <Ellipse Height="35" Width="35"
                                     Stroke="{StaticResource color2}"
                                     StrokeThickness="2"
                                     Margin="10,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Images/profilePicture.jpg" />
                                </Ellipse.Fill>
                            </Ellipse>


                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color3}">
                                <fa:ImageAwesome Icon="ClockOutline" Style="{StaticResource iconButtonIcon}" />
                            </Button>


                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color4}">
                                <fa:ImageAwesome Icon="Envelope" Style="{StaticResource iconButtonIcon}" />
                            </Button>


                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color5}">
                                <fa:ImageAwesome Icon="Bell" Style="{StaticResource iconButtonIcon}" />
                            </Button>

                        </StackPanel>
                    </Grid>
                    
                    <!--Content section / Child view-->
                    <ContentControl Content="{Binding CurrentChildView}"
                                    Grid.Row="2"
                                    Margin="25" />
                </Grid>
                
            </Border>
        </Grid>
        
    </Border>

</Window>
